<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>LOADCAST</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- 키는 Config.xcconfig → (선택적) Secrets.xcconfig 에서 주입. 코드에서 Bundle.main 으로 읽음. -->
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>KakaoNativeAppKey</key>
	<string>$(KAKAO_NATIVE_APP_KEY)</string>
	<key>NaverClientId</key>
	<string>$(NAVER_CLIENT_ID)</string>
</dict>
</plist>
